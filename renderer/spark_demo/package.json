{
  "name": "gs-modelflows-spark-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless Chrome + three.js + Spark GPU SplatSkinning renderer for 3DGS assets",
  "scripts": {
    "sync-vendor": "node -e \"const fs=require('fs');fs.mkdirSync('vendor',{recursive:true});const copy=(s,d)=>fs.copyFileSync(s,'vendor/'+d);copy('node_modules/three/build/three.module.js','three.module.js');copy('node_modules/three/build/three.core.js','three.core.js');copy('node_modules/three/examples/jsm/postprocessing/Pass.js','Pass.js');copy('node_modules/@sparkjsdev/spark/dist/spark.module.min.js','spark.module.min.js');console.log('Synced vendor/ files.');\""
  },
  "dependencies": {
    "@sparkjsdev/spark": "^2.4.0",
    "three": "^0.187.0"
  }
}
